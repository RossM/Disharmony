{
  "metadata": [
    {
      "src": [
        {
          "src": "obj/reference",
          "files": [
            "Disharmony.dll"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "learning-csharp.md",
          "runtime-patching.md",
          "planning-a-game-patch.md",
          "compatibility.md",
          "harmony-comparison.md",
          "analyzer-diagnostics.md",
          "toc.yml",
          "api/**.yml",
          "extension-members.md",
          "usage-examples.md"
        ]
      },
      {
        "src": "obj/guides",
        "files": [
          "*.md"
        ],
        "dest": "guides"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "disableGitFeatures": true,
    "globalMetadata": {
      "_appName": "Disharmony",
      "_appTitle": "Disharmony documentation",
      "_appFooter": "Disharmony · Beta documentation",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
