<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Disharmony</AssemblyName>
    <RootNamespace>Disharmony</RootNamespace>
    <NoWarn>$(NoWarn);DISHARMONY0033</NoWarn>
    <PackageId>Disharmony</PackageId>
    <Title>Disharmony</Title>
    <Authors>Ross Morgan-Linial</Authors>
    <Description>A Harmony-based framework for patching methods and individual calls, member accesses, and constants inside methods. Includes Roslyn analyzers for patch validation.</Description>
    <PackageTags>Harmony;modding;patching;Roslyn;analyzers</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/RossM/Disharmony</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RossM/Disharmony</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations.Sources" Version="2026.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Harmony 3 support is incomplete and subject to change; keep the package dependency within Harmony 2. -->
    <PackageReference Include="Lib.Harmony" Version="[2.4.1,3.0.0-0)" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="Lib.Harmony" Version="[2.4.2,3.0.0-0)" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="PolySharp" Version="1.16.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Disharmony.Analyzers\Disharmony.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="PackageReadme.md" Pack="true" PackagePath="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="IncludeBundledAnalyzer" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Disharmony.Analyzers\Disharmony.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledAnalyzer" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_BundledAnalyzer)" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs/" />
    </ItemGroup>
  </Target>

</Project>
