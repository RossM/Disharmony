<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <OutputType>Exe</OutputType>
    <!-- Program.cs provides the NUnitLite entry point. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <Prefer32Bit>false</Prefer32Bit>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>Disharmony.Tests</RootNamespace>
    <NoWarn>$(NoWarn);DISHARMONY0033</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exercise the minimum supported Harmony version for each runtime. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.1" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnitLite" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Disharmony\Disharmony.csproj" />
    <ProjectReference Include="..\Disharmony.TestTargets\Disharmony.TestTargets.csproj">
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemGroup>

</Project>
