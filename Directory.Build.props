<Project>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="'$(ImportLocalBuildProps)' != 'false' and Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.1.0-rc.2</Version>
    <HarmonyV3Version Condition="'$(HarmonyV3Version)' == ''">3.0.0-rc.7</HarmonyV3Version>
    <WaylithCLRAvailable>false</WaylithCLRAvailable>
    <WaylithCLRAvailable Condition="'$(WaylithCLRDirectory)' != '' and Exists('$(WaylithCLRDirectory)/System.Private.CoreLib.dll') and Exists('$(WaylithCLRDirectory)/System.Runtime.dll')">true</WaylithCLRAvailable>
  </PropertyGroup>
</Project>
