<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Disharmony" Version="[$(DisharmonyPackageVersion)]" />
    <PackageReference Include="Lib.Harmony" Version="[$(HarmonyVersion)]" Condition="'$(HarmonyVersion)' != ''" />
  </ItemGroup>
  <Target Name="RequirePackageVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(DisharmonyPackageVersion)' == ''" Text="Set DisharmonyPackageVersion to the package under test." />
  </Target>
</Project>
