<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <IsPackable>false</IsPackable>
    <WaylithCLRAvailable>false</WaylithCLRAvailable>
    <WaylithCLRAvailable Condition="'$(WaylithCLRDirectory)' != '' and Exists('$(WaylithCLRDirectory)/System.Private.CoreLib.dll') and Exists('$(WaylithCLRDirectory)/System.Runtime.dll')">true</WaylithCLRAvailable>
  </PropertyGroup>

  <!-- WaylithClr types are defined in the game's CoreLib and absent from the SDK reference assemblies. -->
  <PropertyGroup Condition="'$(WaylithCLRAvailable)' == 'true'">
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Disharmony\Disharmony.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(WaylithCLRAvailable)' == 'true'">
    <Reference Include="System.Private.CoreLib">
      <HintPath>$(WaylithCLRDirectory)/System.Private.CoreLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime">
      <HintPath>$(WaylithCLRDirectory)/System.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Override after the SDK imports so an unavailable runtime produces no plugin assembly. -->
  <PropertyGroup Condition="'$(WaylithCLRAvailable)' != 'true'">
    <BuildDependsOn />
  </PropertyGroup>

  <Target Name="ReportSkippedWaylithCLRBuild" BeforeTargets="Build" Condition="'$(WaylithCLRAvailable)' != 'true'">
    <Message Importance="high" Text="Skipping Disharmony.WaylithCLR. Set WaylithCLRDirectory in Directory.Build.local.props to a WaylithCLR install containing System.Private.CoreLib.dll and System.Runtime.dll." />
  </Target>
</Project>
